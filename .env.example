# ---- Supabase (create a free project at https://supabase.com) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Used to hash IPs for affiliate_clicks / contact_submissions (any long random string).
IP_HASH_SALT=change-me-to-a-long-random-string

# ---- Optional ----
# Email provider for newsletter/contact notifications (none configured by default;
# signups are stored in the database until you wire one up).
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
